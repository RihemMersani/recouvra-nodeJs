<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> | Recouvra</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
  </head>
  <body class="<%= user ? 'app-body' : 'auth-body' %>">
    <% if (user) { %>
      <div class="app-shell">
        <aside class="sidebar">
          <a class="brand" href="/dashboard">
            <span class="brand-mark"><i class="bi bi-arrow-up-right"></i></span>
            <span>recouvra<span class="brand-dot">.</span></span>
          </a>
          <div class="sidebar-label">WORKSPACE</div>
          <nav class="nav flex-column sidebar-nav">
            <a class="nav-link active" href="/dashboard"><i class="bi bi-grid-1x2"></i>Overview</a>
            <% if (user.role === 'admin' || user.role === 'manager') { %>
              <a class="nav-link" href="/dashboard#clients"><i class="bi bi-people"></i>All clients</a>
              <a class="nav-link" href="/dashboard#users"><i class="bi bi-person-gear"></i>Team members</a>
              <a class="nav-link" href="/dashboard#payments"><i class="bi bi-receipt"></i>Payments</a>
            <% } else if (user.role === 'agent') { %>
              <a class="nav-link" href="/dashboard#clients"><i class="bi bi-people"></i>My clients</a>
              <a class="nav-link" href="/dashboard#invoices"><i class="bi bi-file-earmark-text"></i>Invoices</a>
              <a class="nav-link" href="/dashboard#payments"><i class="bi bi-cash-coin"></i>Payments</a>
            <% } else { %>
              <a class="nav-link" href="/dashboard#invoices"><i class="bi bi-file-earmark-text"></i>My invoices</a>
              <a class="nav-link" href="/dashboard#payments"><i class="bi bi-clock-history"></i>Payment history</a>
            <% } %>
          </nav>
          <div class="sidebar-footer">
            <div class="secure-note"><i class="bi bi-shield-check"></i><span>Your account is<br>secure and protected</span></div>
          </div>
        </aside>
        <div class="main-column">
          <header class="topbar">
            <div class="d-flex align-items-center gap-3">
              <button class="btn menu-toggle d-lg-none" type="button" aria-label="Toggle navigation" onclick="document.body.classList.toggle('sidebar-open')"><i class="bi bi-list"></i></button>
              <span class="topbar-section">Workspace <i class="bi bi-chevron-right"></i> <strong><%= title %></strong></span>
            </div>
            <div class="dropdown">
              <button class="profile-button dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="avatar"><%= (user.name || 'U').charAt(0).toUpperCase() %></span>
                <span class="profile-copy d-none d-sm-block"><strong><%= user.name %></strong><small><%= user.role %></small></span>
              </button>
              <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                <li><a class="dropdown-item" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>Sign out</a></li>
              </ul>
            </div>
          </header>
          <main class="page-content"><%- body %></main>
        </div>
      </div>
    <% } else { %>
      <main class="auth-shell"><%- body %></main>
    <% } %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
