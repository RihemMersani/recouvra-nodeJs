<section class="login-page">
  <div class="login-decoration decoration-one"></div>
  <div class="login-decoration decoration-two"></div>
  <div class="login-card">
    <a class="brand login-brand" href="/login">
      <span class="brand-mark"><i class="bi bi-arrow-up-right"></i></span>
      <span>recouvra<span class="brand-dot">.</span></span>
    </a>
    <div class="login-eyebrow">WELCOME BACK</div>
    <h1>Sign in to your account</h1>
    <p class="login-subtitle">A clearer view of your finances starts here.</p>
    <% if (error) { %>
      <div class="alert alert-danger py-2" role="alert"><%= error %></div>
    <% } %>
    <form method="post" action="/login">
      <div class="mb-3">
        <label for="email" class="form-label">Email address</label>
        <input id="email" class="form-control form-control-lg" type="email" name="email" autocomplete="username" required autofocus>
      </div>
      <div class="mb-4">
        <label for="password" class="form-label">Password</label>
        <input id="password" class="form-control form-control-lg" type="password" name="password" autocomplete="current-password" required>
      </div>
      <button class="btn btn-primary btn-lg w-100 login-submit" type="submit">Sign in <i class="bi bi-arrow-right ms-2"></i></button>
    </form>
    <div class="login-security"><i class="bi bi-shield-lock"></i> Secure, encrypted access to your account</div>
  </div>
  <div class="login-footer">© <%= new Date().getFullYear() %> Recouvra. Built for better outcomes.</div>
</section>
